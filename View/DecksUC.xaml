<UserControl x:Class="FlashMemo.View.DecksUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FlashMemo.View" 
             xmlns:windows="clr-namespace:FlashMemo.ViewModel.Windows" 
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:wrappers="clr-namespace:FlashMemo.ViewModel.Wrappers"
             xmlns:helpers="clr-namespace:FlashMemo.Helpers"
             x:Name="Root"
             helpers:FocusBoundaryBehavior.EnableBoundaryFocusTracking="True"
             d:DataContext="{d:DesignInstance Type=windows:DecksVM}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid MouseDown="Root_MouseDown">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FF1B1B1B"/>
                <GradientStop Color="#FF1B1B1B" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Deck table header / count legend -->
            <Border
                Grid.Row="0"
                Margin="0,8,0,2"
                Padding="8,0,8,6"
                BorderBrush="#3DFFFFFF"
                BorderThickness="0,0,0,1">

                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DeckTree.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="1"
                        Text="Deck name"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource DeckDimBrush}"
                        VerticalAlignment="Center"/>

                    <Border Grid.Column="2">
                        <TextBlock
                            Text="New"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="{StaticResource DeckNewBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>

                    <Border Grid.Column="3">
                        <TextBlock
                            Text="Learning"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="{StaticResource DeckLearnBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>

                    <Border Grid.Column="4">
                        <TextBlock
                            Text="Review"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="{StaticResource DeckDueBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Empty message -->
            <TextBlock
                Grid.RowSpan="2"
                Text="You dont have any decks. Time to create one!"
                FontSize="26"
                FontWeight="SemiBold"
                Foreground="White"
                Opacity="0.7"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>

                        <Style.Triggers>

                            <!-- Show when DeckTree.Count == 0 -->
                            <DataTrigger
                                Binding="{Binding DeckTree.Count}"
                                Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>

                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Deck list -->
            <syncfusion:SfTreeView
                Name="DeckTree"
                Grid.Row="1"
                ItemsSource="{Binding DeckTree}"
                SelectedItems="{Binding SelectedDecks, Mode=OneWay}"
                SelectionMode="Extended"
                FullRowSelect="True"
                ItemHeight="52"
                Indentation="20"
                ExpanderWidth="34"
                SelectionBackgroundColor="#402A82DA"
                FocusBorderColor="Transparent"
                KeyDown="DeckTree_KeyDown"
                AllowDragging="True"
                AllowDrop="True"
                ItemDragStarting="DeckTree_ItemDragStarting"
                ItemDragOver="DeckTree_ItemDragOver"
                ItemDropping="DeckTree_ItemDropping"
                Drop="DeckTree_Drop"
                Background="Transparent"
                Foreground="{StaticResource DeckTextBrush}"
                BorderThickness="0"
                Margin="8,0"
                VerticalAlignment="Stretch">

                <syncfusion:SfTreeView.Resources>
                    <Style TargetType="syncfusion:TreeViewItem">
                        <EventSetter Event="Loaded" Handler="DeckTreeItem_Loaded"/>
                    </Style>
                    <Storyboard x:Key="DeckDropTargetStoryboard">
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BorderContent" Storyboard.TargetProperty="Background">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource DeckRowHoverBrush}"/>
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BorderContent" Storyboard.TargetProperty="BorderBrush">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource DeckRowHoverBrush}"/>
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_ExpanderView" Storyboard.TargetProperty="Background">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource DeckRowHoverBrush}"/>
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </syncfusion:SfTreeView.Resources>

                <syncfusion:SfTreeView.ExpanderTemplate>
                    <DataTemplate>
                        <Grid Background="Transparent" Cursor="Hand">
                            <Path
                                Width="6" Height="10"
                                Data="M 0,0 L 5,5 L 0,10"
                                Stretch="Uniform"
                                StrokeThickness="1.5"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                RenderTransformOrigin="0.5,0.5">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Stroke" Value="#FF9AA5B1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                                                <Setter Property="Stroke" Value="#FFE6EDF3"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Grid>
                    </DataTemplate>
                </syncfusion:SfTreeView.ExpanderTemplate>

                <syncfusion:SfTreeView.DragPreviewTemplate>
                    <DataTemplate>
                        <Grid Width="36" Height="28" IsHitTestVisible="False">
                            <Rectangle
                                Margin="4"
                                RadiusX="3" RadiusY="3"
                                Fill="#482A3C4F"
                                Stroke="#B0BCCCDC"
                                StrokeThickness="1.5"
                                StrokeDashArray="3,2">
                                <Rectangle.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="StrokeDashOffset"
                                                    From="0" To="10"
                                                    Duration="0:0:1"
                                                    RepeatBehavior="Forever"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Rectangle.Triggers>
                            </Rectangle>
                        </Grid>
                    </DataTemplate>
                </syncfusion:SfTreeView.DragPreviewTemplate>

                <syncfusion:SfTreeView.HierarchyPropertyDescriptors>
                    <syncfusion:HierarchyPropertyDescriptor
                        TargetType="{x:Type wrappers:DeckNode}"
                        ChildPropertyName="Children"
                        IsExpandedPropertyName="IsExpanded"/>
                </syncfusion:SfTreeView.HierarchyPropertyDescriptors>

                <syncfusion:SfTreeView.ItemTemplate>
                    <DataTemplate>
                        <Grid
                            Height="{Binding ItemHeight, RelativeSource={RelativeSource AncestorType=syncfusion:SfTreeView}}"
                            Margin="-4,0"
                            Background="Transparent"
                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=syncfusion:SfTreeView}}"
                            MouseLeftButtonDown="DeckRow_MouseLeftButtonDown"
                            PreviewMouseRightButtonDown="DeckRow_PreviewMouseRightButtonDown">
                            <Grid.ContextMenu>
                                <ContextMenu
                                    Placement="MousePoint"
                                    DataContext="{Binding PlacementTarget.Tag,
                                        RelativeSource={RelativeSource Self}}">

                                    <ContextMenu.Resources>
                                        <Style
                                            x:Key="SingleDeckMenuItemStyle"
                                            TargetType="MenuItem">

                                            <Setter Property="Visibility" Value="Collapsed"/>

                                            <Style.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding DataContext.SelectedDecks.Count,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                    Value="1">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContextMenu.Resources>

                                    <MenuItem
                                        Header="Rename"
                                        Style="{StaticResource SingleDeckMenuItemStyle}"
                                        Command="{Binding PlacementTarget.DataContext.BeginRenameCommand,
                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>

                                    <MenuItem
                                        Header="Options"
                                        Style="{StaticResource SingleDeckMenuItemStyle}"
                                        Command="{Binding DataContext.ShowDeckOptionsCommand,
                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                        CommandParameter="{Binding PlacementTarget.DataContext,
                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>

                                    <MenuItem
                                        Header="Create sub-deck"
                                        Style="{StaticResource SingleDeckMenuItemStyle}"
                                        Command="{Binding DataContext.ShowCreateDeckCommand,
                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                        CommandParameter="{Binding PlacementTarget.DataContext,
                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>

                                    <Separator>
                                        <Separator.Style>
                                            <Style TargetType="Separator">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding DataContext.SelectedDecks.Count,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                        Value="1">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Separator.Style>
                                    </Separator>

                                    <MenuItem
                                        Header="Export"
                                        IsEnabled="True"
                                        Command="{Binding ShowExportMenuCommand}"/>

                                    <MenuItem
                                        Header="Delete"
                                        Command="{Binding DataContext.RemoveDeckCommand,
                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="32" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <TextBlock
                                    Text="{Binding Name}"
                                    FontSize="18"
                                    FontWeight="DemiBold"
                                    Foreground="{StaticResource DeckTextBrush}"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsRenaming,
                                                Converter={StaticResource InverseBoolToVisConverter}}"/>

                                <TextBox
                                    Text="{Binding TempName, UpdateSourceTrigger=PropertyChanged}"
                                    FontSize="18"
                                    Height="30"
                                    Width="300"
                                    Background="Transparent"
                                    Foreground="White"
                                    CaretBrush="White"
                                    VerticalContentAlignment="Center"
                                    HorizontalContentAlignment="Left"
                                    HorizontalAlignment="Left"
                                    Visibility="{Binding IsRenaming,
                                                Converter={StaticResource BoolToVisConverter}}"
                                    KeyDown="RenameBox_KeyDown"
                                    LostFocus="RenameBox_LostFocus"
                                    LostKeyboardFocus="RenameBox_LostFocus"
                                    IsVisibleChanged="RenameBox_IsVisibleChanged"/>
                            </Grid>

                            <Border Grid.Column="1" BorderBrush="#3DFFFFFF" BorderThickness="1,0,0,0">
                                <TextBlock
                                    Text="{Binding LessonsCount}"
                                    FontSize="18"
                                    Foreground="{StaticResource DeckNewBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>

                            <Border Grid.Column="2" BorderBrush="#3DFFFFFF" BorderThickness="1,0,0,0">
                                <TextBlock
                                    Text="{Binding LearningCount}"
                                    FontSize="18"
                                    Foreground="{StaticResource DeckLearnBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>

                            <Border Grid.Column="3" BorderBrush="#3DFFFFFF" BorderThickness="1,0,0,0">
                                <TextBlock
                                    Text="{Binding ReviewsCount}"
                                    FontSize="18"
                                    Foreground="{StaticResource DeckDueBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>

                            <Border Grid.Column="4" BorderBrush="#3DFFFFFF" BorderThickness="1,0,0,0" IsHitTestVisible="False"/>

                            <Button
                                Grid.Column="4"
                                Content="⚙"
                                Style="{StaticResource DeckOptionsButtonStyle}"
                                Click="DeckCtxButton_Click">
                                <Button.Visibility>
                                    <Binding
                                        Path="IsMouseOver"
                                        RelativeSource="{RelativeSource AncestorType=syncfusion:TreeViewItem}"
                                        Converter="{StaticResource BoolToVisConverter}"/>
                                </Button.Visibility>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </syncfusion:SfTreeView.ItemTemplate>
            </syncfusion:SfTreeView>

            <!-- Continuous separators through the header -->
            <Grid
                Grid.Row="0"
                Panel.ZIndex="1"
                Margin="8,8,8,0"
                IsHitTestVisible="False">

                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DeckTree.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="32"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="2" BorderBrush="#3DFFFFFF" BorderThickness="1,0,0,0"/>
                <Border Grid.Column="3" BorderBrush="#3DFFFFFF" BorderThickness="1,0,0,0"/>
                <Border Grid.Column="4" BorderBrush="#3DFFFFFF" BorderThickness="1,0,0,0"/>
                <Border Grid.Column="5" BorderBrush="#3DFFFFFF" BorderThickness="1,0,0,0"/>
            </Grid>

        </Grid>

        <!-- Review heatmap -->
        <Border
            Grid.Row="1"
            Margin="20,6,20,14"
            Padding="14,12"
            Background="#26000000"
            BorderBrush="#2AFFFFFF"
            BorderThickness="1"
            CornerRadius="12"
            Visibility="{Binding Heatmap.HeatmapVisibility,
                Converter={StaticResource BoolToVisConverter}}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    Content="◀"
                    Width="34"
                    Height="34"
                    Margin="0,20,10,0"
                    FontSize="16"
                    FontWeight="Bold"
                    VerticalAlignment="Top"
                    Style="{StaticResource NavButtonStyle}"
                    Command="{Binding Heatmap.ShiftYearBackCommand}"
                    ToolTip="Show previous year"/>

                <StackPanel Grid.Column="1">
                    <TextBlock
                        Text="Review heatmap"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#FFE6EDF3"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,10"/>

                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">

                        <ItemsControl
                            ItemsSource="{Binding Heatmap.Weeks}"
                            HorizontalAlignment="Center">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="16">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="22"/>
                                            <RowDefinition Height="98"/>
                                        </Grid.RowDefinitions>

                                        <!-- A Canvas lets the label extend over neighboring weeks
                                             without changing this week's fixed width. -->
                                        <Canvas Height="18">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="#FFC9D1D9"
                                                Text="{Binding Days,
                                                    Converter={StaticResource ActivityWeekToMonthLabelConverter},
                                                    ConverterParameter=MMM}"/>
                                        </Canvas>

                                        <ItemsControl
                                            Grid.Row="1"
                                            ItemsSource="{Binding Days}">

                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="14"/>
                                                            <RowDefinition Height="14"/>
                                                            <RowDefinition Height="14"/>
                                                            <RowDefinition Height="14"/>
                                                            <RowDefinition Height="14"/>
                                                            <RowDefinition Height="14"/>
                                                            <RowDefinition Height="14"/>
                                                        </Grid.RowDefinitions>
                                                    </Grid>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter
                                                        Property="Grid.Row"
                                                        Value="{Binding WeekdayIndex}"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        Width="12"
                                                        Height="12"
                                                        Margin="1"
                                                        CornerRadius="2"
                                                        BorderThickness="1"
                                                        ToolTipService.InitialShowDelay="0"
                                                        Background="{Binding Intensity,
                                                            Converter={StaticResource ActivityIntensityToBrushConverter},
                                                            ConverterParameter=ActivityHeatBlue}">

                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="BorderBrush" Value="White"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>

                                                        <Border.ToolTip>
                                                            <StackPanel>
                                                                <TextBlock
                                                                    Foreground="Black"
                                                                    Text="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}"/>
                                                                <TextBlock
                                                                    Foreground="Black"
                                                                    Text="{Binding ReviewCount, StringFormat={}{0} reviews}"/>
                                                            </StackPanel>
                                                        </Border.ToolTip>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock
                        Margin="0,10,0,0"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="#FFE6EDF3"
                        HorizontalAlignment="Center"
                        Text="{Binding Heatmap.HeatmapYear}"/>
                </StackPanel>

                <Button
                    Grid.Column="2"
                    Content="▶"
                    Width="34"
                    Height="34"
                    Margin="10,20,0,0"
                    FontSize="16"
                    FontWeight="Bold"
                    VerticalAlignment="Top"
                    Style="{StaticResource NavButtonStyle}"
                    Command="{Binding Heatmap.ShiftYearForwardCommand}"
                    ToolTip="Show next year"/>
            </Grid>
        </Border>

        <!-- Refresh Decks Button -->
        <Button
            Grid.Row="2"
            Content="Refresh decks"
            Command="{Binding ReloadDomainCommand}"
            Style="{StaticResource NavButtonStyle}"
            Width="125"
            Height="45"
            HorizontalAlignment="Center"
            Margin="0,0,150,20"/>

        <!-- Create Deck Button -->
        <Button
            Grid.Row="2"
            Content="Create Deck"
            Command="{Binding ShowCreateDeckCommand}"
            Style="{StaticResource NavButtonStyle}"
            Width="120"
            Height="45"
            HorizontalAlignment="Center"
            Margin="150,0,0,20"/>

        <!-- Popup Overlay -->
        <Grid
            Grid.RowSpan="3"
            Background="#80000000"
            Visibility="{Binding CurrentPopup,
                Converter={StaticResource NullToVisConverter}}">

            <!-- Popup content -->
            <ContentControl
            Content="{Binding CurrentPopup}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"/>
        </Grid>


    </Grid>
</UserControl>
