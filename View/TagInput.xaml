<UserControl x:Class="FlashMemo.View.TagInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sf="http://schemas.syncfusion.com/wpf"
             PreviewKeyDown="OnPreviewKeyDown">
    <sf:SfTextBoxExt x:Name="Input"
                     AutoCompleteSource="{Binding AllTags}"
                     SelectedItems="{Binding SelectedTags, Mode=OneWay}"
                     SearchItemPath="Name"
                     AutoCompleteMode="Suggest"
                     SuggestionMode="ContainsOrdinal"
                     MultiSelectMode="Token"
                     TokensWrapMode="Wrap"
                     EnableAutoSize="True"
                     MaxDropDownHeight="190"
                     MinHeight="34"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="White"
                     CaretBrush="White"
                     DropDownBackground="#FF31343A"
                     Watermark="Enter a tag"
                     FontSize="24">
        <sf:SfTextBoxExt.TokenItemContainerStyle>
            <Style TargetType="sf:TokenItem">
                <Setter Property="Background" Value="#55000000"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#88FFFFFF"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>
        </sf:SfTextBoxExt.TokenItemContainerStyle>
        <sf:SfTextBoxExt.AutoCompleteItemTemplate>
            <DataTemplate>
                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="20" Margin="8,4"/>
            </DataTemplate>
        </sf:SfTextBoxExt.AutoCompleteItemTemplate>
    </sf:SfTextBoxExt>
</UserControl>